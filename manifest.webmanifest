{
  "name": "فواتير الأوردرات",
  "short_name": "فواتير",
  "description": "حوّل شات واتساب لفواتير جاهزة PDF A4",
  "lang": "ar",
  "dir": "rtl",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#f6f1f1",
  "theme_color": "#b76e79",
  "icons": [
    {"src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any"},
    {"src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any"},
    {"src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable"}
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {"files": [{"name": "chat", "accept": ["application/zip", "application/x-zip-compressed", "text/plain", ".zip", ".txt"]}]}
  }
}
